# CareLoop — environment template. Placeholders only; never commit real values.
# Copy to .env.local and fill in.

# --- Supabase (M0) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Must never be imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# LOCAL DEVELOPMENT ONLY. UUID of a Supabase Auth user, used when no session
# cookie is present. It is honoured only when NODE_ENV === "development" AND
# the process is not running on Vercel, so setting it on a deployment (even by
# accident) can never authenticate a request. Anything else fails closed.
# Create the user in the Supabase dashboard: Authentication -> Users -> Add
# user, then paste its UUID here.
CARELOOP_DEV_USER_ID=

# --- OpenAI ---
OPENAI_API_KEY=
# M1: fast streaming conversational model (latency and warmth).
OPENAI_CHAT_MODEL=gpt-4o-mini
# M2: stronger model for post-turn extraction (accuracy and structure, off the
# critical path). Separate on purpose - the two have opposite requirements.
OPENAI_EXTRACTION_MODEL=gpt-4o
# M2: embeddings. Used for exactly one column, episodes.embedding.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# M4: the isolated family-message renderer. A different job from conversation
# - one short sentence, no history, maximum conservatism - so it is pinned
# separately. Optional: falls back to OPENAI_CHAT_MODEL. The call site, prompt
# version (family-render.v2) and log event stay distinct either way.
OPENAI_FAMILY_RENDER_MODEL=
# M8: speech to text. DORMANT. Transcription runs on Cloudflare Workers AI
# (see below); nothing constructs the OpenAI transcription adapter any more.
# Kept because the adapter and its tests are still in the tree.
OPENAI_TRANSCRIPTION_MODEL=
# --- ElevenLabs (M8, text to speech) ---
# OPTIONAL. Without BOTH of these, CareLoop is fully usable by typing and by
# speaking - only reading replies aloud is unavailable, and the speak endpoint
# answers a clean 503 rather than failing.
ELEVENLABS_API_KEY=
# The voice to speak in. Server-side only; never exposed to the browser.
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_turbo_v2_5.
ELEVENLABS_MODEL_ID=

# Development only. Required by POST /api/dev/seed-events and
# POST /api/dev/detect, both of which are absent outside local development.
# Any random string.
CARELOOP_DEV_SEED_SECRET=

# DORMANT, as above. The active transcription language is
# CARELOOP_TRANSCRIPTION_LANGUAGE.
OPENAI_TRANSCRIPTION_LANGUAGE=en

# --- Cloudflare Workers AI (speech to text) ---
# REQUIRED. Transcription runs here, and only here: there is deliberately no
# fallback to the OpenAI transcription API, so a missing value fails loudly
# instead of quietly spending OpenAI credits.
#
# Both are SERVER-ONLY. Never rename either to NEXT_PUBLIC_*: that prefix is
# inlined into the browser bundle at build time and would publish the token.
# Dashboard -> Workers & Pages -> the account id in the right-hand pane; the
# token needs the "Workers AI" read permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional. Defaults to @cf/openai/whisper-large-v3-turbo.
CLOUDFLARE_TRANSCRIPTION_MODEL=
# Language for speech-to-text. Pinned rather than detected: a one-word clip
# gives automatic detection almost nothing to work with, and a live "yes" came
# back as a Chinese character. A demo/product-locale setting for this English
# POC; it becomes profile/session language later. Default: en
CARELOOP_TRANSCRIPTION_LANGUAGE=en


# --- Deployment ---

# Where a family member's capability link points. It is CONFIGURATION, never
# derived from the request Host header - taking it from a header would let
# whoever sends a request decide where somebody's reply link goes.
#
# Local development may leave this empty and get http://localhost:3000. A
# DEPLOYMENT must set it, and it is checked: absolute, https (the link IS the
# credential), and not localhost. A misconfigured value fails loudly rather
# than minting links to the recipient's own machine.
CARELOOP_PUBLIC_BASE_URL=

# Turns this deployment into a PUBLIC DEMO: an anonymous visitor may create a
# temporary Supabase session and be seeded their own private George fixture.
#
# Exactly the string "true" enables it. Anything else - missing, empty,
# "false", "TRUE", "1" - leaves it off, because a flag that decides whether
# strangers can create accounts must not be switched on by a typo.
#
# Anonymous does NOT mean unauthenticated: the visitor holds a real validated
# Supabase session with its own UUID, simply with no email attached.
CARELOOP_DEMO_MODE=false

# --- Brevo (M11, production family delivery by email) ---
#
# Server-only, all three. Never NEXT_PUBLIC_: the key would be in the bundle.
#
# Local development does not use these at all - it delivers to the development
# inbox at /dev/family-inbox and calls no provider. A DEPLOYMENT with
# CARELOOP_DEMO_MODE=true requires all three, and fails closed by name if any
# is missing.
BREVO_API_KEY=
# The verified sender. Brevo will refuse mail from an unverified domain.
#
# Also required on the account before live acceptance: Settings > Contacts >
# Per-contact pixel tracking consent, enabled, with unknown contacts set to
# No. Every send already declines tracking per recipient, but the field is only
# honoured when that feature is on - and click tracking would otherwise rewrite
# the Reply link and route a live capability token through Brevo.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CareLoop
