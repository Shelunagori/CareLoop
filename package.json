{
  "name": "careloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --linked --schema public > server/db/types.generated.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types:local": "supabase gen types typescript --local --schema public > server/db/types.generated.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:llm-contract": "vitest run --config vitest.contract.config.mts",
    "test:ui": "vitest run --project ui",
    "reembed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/reembed.ts",
    "reembed:dry": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/reembed.ts --dry-run",
    "reembed:status": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/reembed.ts --status",
    "cloudflare:smoke": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/cloudflare-smoke.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "openai": "^7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.10.1",
    "jsdom": "^26.1.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
